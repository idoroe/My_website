---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import createSlug from "../../lib/createSlug";
export async function getStaticPaths() {
  return (await getCollection("projects")).map(project => ({ params: { slug: createSlug(project.data.title, project.slug) }, props: { project } }));
}
interface Props { project: CollectionEntry<"projects">; }
const { project } = Astro.props;
const { Content, headings } = await project.render();
const { title, description, heroImage, category, role, techStack, challenges, impact, githubUrl, screenshots } = project.data;
const captions: Record<string, string> = {
  'finsight-dashboard': 'Transaction dashboard and summary metrics',
  'finsight-anomalies': 'Anomaly review with severity-ranked explanations',
  'finsight-transactions': 'Transaction records and filters',
  'pipelinex-grafana': 'Grafana observability dashboard',
  'pipelinex-api': 'FinSight API documentation',
  'labelforge-hero': 'Annotation platform overview',
  'labelforge-annotate': 'Task annotation workspace',
  'labelforge-quality': 'Quality metrics by project and annotator',
  'labelforge-review': 'Reviewer workflow and task feedback',
  'labelforge-admin': 'Project administration workspace',
};
---
<BaseLayout title={title} description={description} image={heroImage} activeItemID="projects" ogType="article">
  <article class="py-4">
    <a href="/projects" class="section-link">← All projects</a>
    <header class="page-heading pb-6 max-w-4xl"><p class="eyebrow">Personal project · {category}</p><h1>{title}<span class="text-primary">.</span></h1><p>{description}</p>{githubUrl && <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-gradient">Explore source code ↗</a>}</header>
    {heroImage && <figure class="mb-10"><img src={heroImage} alt={`${title} application overview`} width="1280" height="720" class="w-full h-auto rounded-xl border border-base-300" /><figcaption class="text-xs text-base-content/70 mt-3">{title} · Personal project interface</figcaption></figure>}
    <div class="project-body-grid">
      <aside class="project-brief" aria-label="Project brief">
        <h2>My role</h2><p>{role}</p>
        <h2 class="mt-6">Tools & technologies</h2><ul class="flex flex-wrap gap-2 mt-3">{techStack.map(tech => <li class="skill-chip">{tech}</li>)}</ul>
        <nav aria-label="Case study sections" class="mt-7"><h2>In this case study</h2><ul class="space-y-2 mt-3">{headings.filter(heading => heading.depth === 2).map(heading => <li><a href={`#${heading.slug}`} class="hover:text-primary">{heading.text}</a></li>)}<li><a href="#screenshots" class="hover:text-primary">Screenshots</a></li></ul></nav>
      </aside>
      <div class="min-w-0">
        {impact && <section class="project-result"><p class="eyebrow mb-2">What the work achieved</p><h2 class="sr-only">Results</h2><p>{impact}</p></section>}
        {challenges && <section class="mb-8"><h2 class="text-xl font-semibold mb-3">The engineering challenge</h2><p class="text-base-content/80">{challenges}</p></section>}
        <div class="prose prose-lg max-w-none"><Content /></div>
      </div>
    </div>
    {screenshots.length > 0 && <section id="screenshots" class="section-block mt-10"><div class="section-heading"><div><p class="eyebrow">A closer look</p><h2>Screenshots</h2></div><p class="text-sm text-base-content/70">Select an image to open the full-size view.</p></div><div class="grid md:grid-cols-2 gap-6">{screenshots.map(src => {
      const caption = captions[src.split('/').pop()?.replace('.webp', '') ?? ''] || `${title} interface`;
      return <figure><a href={src} target="_blank" rel="noopener noreferrer" aria-label={`${caption} — open full-size image`} class="block rounded-xl overflow-hidden border border-base-300 hover:border-primary"><img src={src} alt={caption} class="w-full h-auto" loading="lazy" /></a><figcaption class="text-sm text-base-content/70 mt-3">{caption}</figcaption></figure>;
    })}</div></section>}
    <div class="flex flex-wrap justify-between gap-4 border-t border-base-300 pt-8"><a href="/projects" class="section-link">← Explore other projects</a><a href="/contact" class="section-link">Talk about this work ↗</a></div>
  </article>
</BaseLayout>
<style>
  .project-body-grid { display: grid; grid-template-columns: 15rem minmax(0, 1fr); gap: 3.5rem; align-items: start; }
  .project-brief { position: sticky; top: 6rem; padding-right: 1.5rem; border-right: 1px solid oklch(var(--bc) / .12); font-size: .8rem; color: oklch(var(--bc) / .8); }
  .project-brief h2 { font-size: .65rem; text-transform: uppercase; letter-spacing: .12em; font-weight: 600; margin-bottom: .7rem; color: oklch(var(--bc)); }
  .project-result { padding: 1.5rem; border-left: 3px solid oklch(var(--p)); background: oklch(var(--p) / .05); border-radius: 0 .6rem .6rem 0; margin-bottom: 2rem; font-size: .95rem; }
  @media (max-width: 767px) { .project-body-grid { grid-template-columns: 1fr; gap: 2rem; } .project-brief { position: static; border-right: 0; border-bottom: 1px solid oklch(var(--bc) / .12); padding: 0 0 1.5rem; } }
</style>
