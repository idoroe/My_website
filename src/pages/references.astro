---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SOCIAL_LINKS } from "../config";

const facultyProfile = "https://profiles.ucalgary.ca/ronnie-de-souza-santos";
const linkedInProfile = "https://www.linkedin.com/in/drdesouzasantos/";
const introductionSubject = "Academic reference request for Emmanuel Idoro";
const introductionBody = "Hi Emmanuel,\n\nI would like to arrange an academic reference with Dr. Ronnie de Souza Santos.\n\nRole and organization: \nPreferred next step: \n\nThank you.";
const introductionLink = `mailto:${SOCIAL_LINKS.email}?subject=${encodeURIComponent(introductionSubject)}&body=${encodeURIComponent(introductionBody)}`;
---

<BaseLayout
  title="References | Emmanuel Idoro"
  description="Academic reference for Emmanuel Idoro: Dr. Ronnie de Souza Santos, Software Architecture instructor and Assistant Professor at the University of Calgary."
  activeItemID="references"
>
  <div class="py-4 space-y-8 sm:space-y-10">
    <header class="page-heading max-w-2xl">
      <p class="eyebrow">Beyond the resume</p>
      <h1>References<span class="text-primary">.</span></h1>
      <p class="text-base-content/70 text-lg leading-relaxed">
        An academic perspective on my work, from my software engineering studies at the University of Calgary.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
      <article class="reference-card lg:col-span-2 rounded-2xl border border-base-300 overflow-hidden" aria-labelledby="reference-name">
        <div class="reference-card-heading px-6 py-7 sm:px-8 sm:py-8">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-11 h-11 shrink-0 rounded-xl gradient-icon-bg flex items-center justify-center text-primary">
              <svg aria-hidden="true" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                <path stroke-linecap="round" stroke-linejoin="round" d="m3 9 9-5 9 5-9 5-9-5Zm4 2.25V17c3 2.67 7 2.67 10 0v-5.75M21 9v7" />
              </svg>
            </div>
            <span class="text-xs font-semibold uppercase tracking-widest text-primary">Academic reference</span>
          </div>
          <h2 id="reference-name" class="text-2xl sm:text-3xl font-bold leading-tight">Dr. Ronnie de Souza Santos</h2>
          <p class="text-primary font-medium mt-3">Assistant Professor</p>
          <p class="text-base-content/70 text-sm leading-relaxed mt-2">
            Department of Electrical and Software Engineering<br />
            Schulich School of Engineering<br />
            University of Calgary
          </p>
        </div>

        <div class="px-6 py-7 sm:px-8 space-y-6">
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-base-content/70 mb-3">How we worked together</h3>
            <p class="text-base-content/80 leading-relaxed">
              Dr. de Souza Santos taught me Software Architecture (SENG 401) and has agreed to serve as an academic reference.
            </p>
          </div>

          <div class="flex flex-wrap gap-3">
            <a href={facultyProfile} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm gap-2">
              University profile
              <svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 3h6v6m0-6L10 14M9 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-4" />
              </svg>
            </a>
            <a href={linkedInProfile} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm gap-2">
              LinkedIn
              <svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 3h6v6m0-6L10 14M9 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-4" />
              </svg>
            </a>
          </div>

          <p class="text-xs leading-relaxed text-base-content/70 border-t border-base-300 pt-5">
            Faculty title, affiliation, and course information are listed on his
            <a href={facultyProfile} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-primary">University of Calgary profile</a>.
          </p>
        </div>
      </article>

      <aside class="rounded-2xl bg-base-200 border border-base-300 p-6 sm:p-7" aria-labelledby="introduction-heading">
        <p class="text-xs font-semibold tracking-widest uppercase text-primary mb-3">For hiring teams</p>
        <h2 id="introduction-heading" class="text-xl font-bold mb-3">Arrange a reference</h2>
        <p class="text-sm text-base-content/70 leading-relaxed mb-5">
          If a reference is part of your hiring process, send me the role, your organization, and your preferred next step. I can coordinate an introduction.
        </p>
        <a href={introductionLink} class="btn btn-gradient w-full h-auto min-h-[3rem] py-3 text-sm">
          Request an introduction
        </a>
        <p class="text-xs text-base-content/70 leading-relaxed mt-3">Opens an email to me with the request started for you.</p>
        <div class="border-t border-base-300 mt-6 pt-5">
          <a href="/resume" class="text-sm font-semibold inline-flex items-center gap-2 hover:text-primary transition-colors">
            View my resume
            <svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .reference-card-heading {
    background: linear-gradient(135deg, oklch(var(--p) / 0.09), oklch(var(--s) / 0.04));
    border-bottom: 1px solid oklch(var(--bc) / 0.08);
  }
</style>
