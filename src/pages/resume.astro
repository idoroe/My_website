---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PERSON_NAME, SOCIAL_LINKS, PERSON_PHONE, PERSON_LOCATION } from "../config";
import { EDUCATION, EXPERIENCE, SKILLS, PROJECT_SUMMARIES, RESUME_URL, RESUME_FILENAME } from "../data/profile";
---
<BaseLayout title="Resume" description="View or download Emmanuel Idoro’s resume: RBC Data Engineer Intern, AI model training experience, and Software Engineering projects." activeItemID="resume">
  <header class="page-heading no-print"><p class="eyebrow">Experience, in one place</p><h1>Resume<span class="text-primary">.</span></h1><p>Data engineering, software development, and AI model evaluation.</p><div class="flex flex-wrap gap-3 mt-6"><a href={RESUME_URL} download={RESUME_FILENAME} class="btn btn-gradient">Download PDF ↓</a><a href={RESUME_URL} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Open PDF ↗</a><a href="#resume-text" class="btn btn-ghost">Read on this page</a></div></header>
  <details class="resume-preview no-print"><summary>Preview the PDF <span class="text-sm font-normal text-base-content/70">Expand viewer</span></summary><p class="px-5 pb-4 text-sm text-base-content/75">If your browser cannot display the preview, <a href={RESUME_URL} class="text-primary underline" target="_blank" rel="noopener noreferrer">open the PDF</a> or read the complete text below.</p><iframe src={RESUME_URL} title="Emmanuel Idoro resume PDF" class="w-full h-[80vh] bg-white" loading="lazy"></iframe></details>
  <article id="resume-text" class="resume-text">
    <header class="resume-identity"><h2>{PERSON_NAME}</h2><p>{PERSON_LOCATION} · <a href={`mailto:${SOCIAL_LINKS.email}`}>{SOCIAL_LINKS.email}</a> · <a href={`tel:+1${PERSON_PHONE.replace(/\D/g, '')}`}>{PERSON_PHONE}</a></p><div class="flex gap-4 mt-3"><a href={SOCIAL_LINKS.github}>GitHub ↗</a><a href={SOCIAL_LINKS.linkedin}>LinkedIn ↗</a><a href="/references">References ↗</a></div></header>
    <section><h3>Education</h3><h4>{EDUCATION.degree}</h4><p>{EDUCATION.university}, {EDUCATION.school}</p><p>{EDUCATION.dates} · Expected graduation: {EDUCATION.graduation}</p><p class="mt-2">Relevant coursework: {EDUCATION.coursework.join(', ')}.</p></section>
    <section><h3>Skills</h3><div class="space-y-3">{SKILLS.map(category => <p><strong>{category.label}:</strong> {category.items.join(', ')}</p>)}</div></section>
    <section><h3>Professional experience</h3>{EXPERIENCE.map(job => <div class="resume-job"><div class="resume-job-heading"><h4>{job.company}</h4><span>{job.dates} · {job.location}</span></div><p class="font-medium">{job.role}</p>{job.note && <p class="text-sm mt-1">{job.note}</p>}<ul>{job.bullets.map(bullet => <li>{bullet}</li>)}</ul></div>)}</section>
    <section><h3>Personal projects</h3>{PROJECT_SUMMARIES.map(project => <div class="resume-job"><h4><a href={project.href}>{project.name} ↗</a> — {project.subtitle}</h4><p class="text-sm mt-1">{project.stack}</p><ul>{project.bullets.map(bullet => <li>{bullet}</li>)}</ul></div>)}</section>
  </article>
</BaseLayout>
