---
import BaseLayout from "../layouts/BaseLayout.astro";
import { EXPERIENCE, EDUCATION, SKILLS, RESUME_URL, RESUME_FILENAME } from "../data/profile";
---
<BaseLayout title="Experience" description="Emmanuel Idoro’s experience at RBC, Mindrift AI, and Outlier AI, plus Software Engineering education at the University of Calgary." activeItemID="experience">
  <header class="page-heading"><p class="eyebrow">The work behind the portfolio</p><h1>Experience<span class="text-primary">.</span></h1><p>Enterprise data, AI model evaluation, and a foundation in software engineering.</p><a class="section-link" href={RESUME_URL} download={RESUME_FILENAME}>Download resume ↓</a></header>
  <section aria-labelledby="work-title"><h2 id="work-title" class="text-2xl font-bold mb-8">Professional experience</h2><div class="experience-list">
    {EXPERIENCE.map(job => <article id={job.id} class:list={['experience-entry', { 'experience-featured': job.id === 'rbc' }]}>
      <div class="experience-meta"><p>{job.dates}</p><p>{job.location}</p>{job.note && <span class="text-primary text-sm mt-3 block">{job.note}</span>}</div>
      <div><h3 class="text-xl font-bold">{job.role}</h3><p class="text-lg text-base-content/75 mt-1 mb-5">{job.company}</p><ul class="list-disc pl-5 space-y-3 text-base-content/80 leading-relaxed">{job.bullets.map(bullet => <li>{bullet}</li>)}</ul><ul class="flex flex-wrap gap-2 mt-5">{job.technologies.map(tech => <li class="skill-chip">{tech}</li>)}</ul></div>
    </article>)}
  </div></section>
  <section class="section-block" aria-labelledby="education-title"><p class="eyebrow">Education</p><h2 id="education-title" class="text-2xl font-bold">{EDUCATION.degree}</h2><p class="mt-3 text-lg">{EDUCATION.university} · {EDUCATION.school}</p><p class="text-base-content/70 mt-1">{EDUCATION.dates} · Expected graduation: {EDUCATION.graduation}</p><h3 class="font-semibold mt-6 mb-3">Relevant coursework</h3><ul class="flex flex-wrap gap-2">{EDUCATION.coursework.map(course => <li class="skill-chip">{course}</li>)}</ul><a href="/references" class="section-link inline-block mt-6">Academic reference ↗</a></section>
  <section class="section-block" aria-labelledby="skills-title"><h2 id="skills-title" class="text-2xl font-bold mb-6">Technical skills</h2><div class="space-y-6">{SKILLS.map(category => <div class="skill-row"><h3>{category.label}</h3><ul class="flex flex-wrap gap-2">{category.items.map(skill => <li class="skill-chip">{skill}</li>)}</ul></div>)}</div></section>
</BaseLayout>
