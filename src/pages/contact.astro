---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SOCIAL_LINKS, PERSON_PHONE, PERSON_LOCATION } from "../config";
import { EDUCATION, RESUME_URL, RESUME_FILENAME } from "../data/profile";
const emailHref = `mailto:${SOCIAL_LINKS.email}?subject=${encodeURIComponent('Opportunity for Emmanuel Idoro')}`;
---
<BaseLayout title="Contact" description="Contact Emmanuel Idoro about software engineering, data engineering, and collaboration opportunities. Based in Calgary, Canada." activeItemID="contact">
  <header class="page-heading"><p class="eyebrow">Start a conversation</p><h1>Let’s build something useful<span class="text-primary">.</span></h1><p>I’m interested in conversations about software engineering, data engineering, and thoughtful ways to use AI.</p></header>
  <div class="contact-grid">
    <section class="contact-primary" aria-labelledby="email-title"><span class="eyebrow">The best way to reach me</span><h2 id="email-title">Say hello.</h2><a href={emailHref} class="contact-email">{SOCIAL_LINKS.email} <span aria-hidden="true">↗</span></a><p>Include a little about your team, the opportunity, and your timeline. I’d be happy to connect.</p><div class="flex flex-wrap items-center gap-3 mt-6"><a href={emailHref} class="btn btn-gradient">Write an email ↗</a><button type="button" id="copy-email" data-email={SOCIAL_LINKS.email} class="btn btn-outline" hidden>Copy email</button></div><p id="copy-status" class="text-sm min-h-6 mt-3" role="status" aria-live="polite"></p></section>
    <aside class="contact-aside" aria-label="Contact details"><div><h2>Based in</h2><p>{PERSON_LOCATION}</p></div><div><h2>Currently</h2><p>Data Engineer Intern at RBC</p><p class="text-sm text-base-content/70">May – December 2026</p></div><div><h2>Education</h2><p>B.Sc. Software Engineering</p><p class="text-sm text-base-content/70">Expected graduation: {EDUCATION.graduation}</p></div><a class="section-link" href={`tel:+1${PERSON_PHONE.replace(/\D/g, '')}`}>{PERSON_PHONE} ↗</a></aside>
  </div>
  <section class="section-block" aria-labelledby="connect-title"><div class="section-heading"><div><p class="eyebrow">Keep exploring</p><h2 id="connect-title">Everything you need to connect.</h2></div></div><div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <a class="resource-card" href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer"><h3>LinkedIn ↗</h3><p>Connect professionally.</p></a><a class="resource-card" href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer"><h3>GitHub ↗</h3><p>Explore the source code.</p></a><a class="resource-card" href={RESUME_URL} download={RESUME_FILENAME}><h3>Resume ↓</h3><p>Download the PDF.</p></a><a class="resource-card" href="/references"><h3>References ↗</h3><p>Arrange an academic reference.</p></a>
  </div></section>
</BaseLayout>
<script>
  function initCopyEmail() {
    const button = document.querySelector<HTMLButtonElement>('#copy-email');
    const status = document.querySelector<HTMLElement>('#copy-status');
    if (!button || !status || !navigator.clipboard?.writeText) return;
    button.hidden = false;
    button.onclick = async () => {
      try { await navigator.clipboard.writeText(button.dataset.email || ''); status.textContent = 'Email address copied.'; }
      catch { status.textContent = 'Copy unavailable. Select the email address above or use “Write an email”.'; }
    };
  }
  document.addEventListener('astro:page-load', initCopyEmail);
</script>
