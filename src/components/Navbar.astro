---
import { NAV_ITEMS, PERSON_NAME } from "../config";

interface Props {
  activeItemID?: string;
}

const { activeItemID } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActiveItem = (item: { label: string; href: string }) => activeItemID
  ? activeItemID === item.label.toLowerCase()
  : currentPath === item.href || (item.href !== '/' && currentPath.startsWith(`${item.href}/`));
---

<nav class="navbar-blur sticky top-0 z-50 bg-base-100/80" aria-label="Main navigation">
  <div class="gradient-divider absolute bottom-0 left-0 right-0"></div>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo / Brand -->
      <a href="/" aria-label={`${PERSON_NAME} — Home`} class="text-xl font-bold gradient-text hover:opacity-80 transition-opacity">
        EI
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        {NAV_ITEMS.map((item) => {
          const isActive = isActiveItem(item);
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                "px-3 py-2 rounded-lg text-sm font-medium transition-colors",
                isActive
                  ? "bg-primary/10 text-primary"
                  : "text-base-content/70 hover:text-base-content hover:bg-base-200",
              ]}
            >
              {item.label}
            </a>
          );
        })}

        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          type="button"
          class="ml-2 btn btn-ghost btn-sm btn-circle hidden"
          aria-label="Switch to dark theme"
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg id="sun-icon" aria-hidden="true" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg id="moon-icon" aria-hidden="true" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center lg:hidden gap-2">
        <button
          id="theme-toggle-mobile"
          type="button"
          class="btn btn-ghost btn-sm btn-circle hidden"
          aria-label="Switch to dark theme"
        >
          <svg id="sun-icon-mobile" aria-hidden="true" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg id="moon-icon-mobile" aria-hidden="true" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
        <button
          id="mobile-menu-btn"
          type="button"
          class="btn btn-ghost btn-sm btn-square hidden"
          aria-label="Open menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg id="hamburger-icon" aria-hidden="true" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" aria-hidden="true" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="lg:hidden pb-4">
      <div class="flex flex-col gap-1">
        {NAV_ITEMS.map((item) => {
          const isActive = isActiveItem(item);
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                "px-3 py-2 rounded-lg text-sm font-medium transition-colors",
                isActive
                  ? "bg-primary/10 text-primary"
                  : "text-base-content/70 hover:text-base-content hover:bg-base-200",
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </div>
    </div>
  </div>
</nav>

<script>
  let navbarController: AbortController | undefined;

  function initNavbar() {
    navbarController?.abort();
    navbarController = new AbortController();
    const { signal } = navbarController;
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    function setMenuOpen(isOpen: boolean) {
      mobileMenu?.classList.toggle('hidden', !isOpen);
      hamburgerIcon?.classList.toggle('hidden', isOpen);
      closeIcon?.classList.toggle('hidden', !isOpen);
      menuBtn?.setAttribute('aria-expanded', String(isOpen));
      menuBtn?.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    }

    // The mobile links remain available if JavaScript is disabled.
    setMenuOpen(false);
    menuBtn?.classList.remove('hidden');
    menuBtn?.addEventListener('click', () => {
      setMenuOpen(menuBtn.getAttribute('aria-expanded') !== 'true');
    }, { signal });

    mobileMenu?.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setMenuOpen(false);
    }, { signal });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') {
        setMenuOpen(false);
        menuBtn.focus();
      }
    }, { signal });

    document.addEventListener('click', (event) => {
      if (!(event.target as Element).closest('nav[aria-label="Main navigation"]')) {
        setMenuOpen(false);
      }
    }, { signal });

    window.matchMedia('(min-width: 1024px)').addEventListener('change', () => {
      setMenuOpen(false);
    }, { signal });

    // Theme toggle
    function updateThemeIcons() {
      const theme = document.documentElement.getAttribute('data-theme');
      const isDark = theme === 'dark';

      document.getElementById('sun-icon')?.classList.toggle('hidden', !isDark);
      document.getElementById('moon-icon')?.classList.toggle('hidden', isDark);
      document.getElementById('sun-icon-mobile')?.classList.toggle('hidden', !isDark);
      document.getElementById('moon-icon-mobile')?.classList.toggle('hidden', isDark);
      document.querySelectorAll<HTMLButtonElement>('#theme-toggle, #theme-toggle-mobile').forEach((button) => {
        button.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} theme`);
        button.setAttribute('title', `Switch to ${isDark ? 'light' : 'dark'} theme`);
      });
    }

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        // The theme still works when the browser blocks persistent storage.
      }
      updateThemeIcons();
    }

    document.querySelectorAll<HTMLButtonElement>('#theme-toggle, #theme-toggle-mobile').forEach((button) => {
      button.classList.remove('hidden');
      button.addEventListener('click', toggleTheme, { signal });
    });

    updateThemeIcons();
  }

  initNavbar();
  document.addEventListener('astro:page-load', initNavbar);
  document.addEventListener('astro:before-swap', () => navbarController?.abort());
</script>
