---
const { title, img, desc, url, badge, tags = [], pubDate, target = "_self" } = Astro.props;
import { Image } from "astro:assets";
const displayDate = pubDate && new Intl.DateTimeFormat("en-CA", {
  month: "short", day: "numeric", year: "numeric", timeZone: "UTC",
}).format(new Date(pubDate));
---

<article class="rounded-2xl border border-base-300 bg-base-100 p-5 sm:p-6 transition-shadow hover:shadow-lg">
  <div class="flex flex-col gap-6 md:flex-row md:items-start">
    {img && (
      <Image src={img} width={750} height={422} format="webp" alt=""
        class="w-full md:w-52 rounded-xl object-cover" loading="lazy" />
    )}
    <div class="min-w-0 grow">
      {pubDate && <time datetime={new Date(pubDate).toISOString()} class="text-sm text-base-content/65">{displayDate}</time>}
      <h2 class="mt-1 text-xl font-bold leading-snug">
        <a href={url} target={target} rel={target === "_blank" ? "noopener noreferrer" : undefined}
          class="rounded-sm hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-4">
          {title}
        </a>
      </h2>
      {badge && <span class="badge badge-secondary mt-2">{badge}</span>}
      <p class="mt-3 leading-relaxed text-base-content/75">{desc}</p>
      {tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Article topics">
          {tags.map((tag) => (
            <li><a href={`/blog/tag/${encodeURIComponent(tag)}`} class="badge badge-outline h-auto min-h-7 py-1 hover:bg-base-200">{tag}</a></li>
          ))}
        </ul>
      )}
    </div>
  </div>
</article>
