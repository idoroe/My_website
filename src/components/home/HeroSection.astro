---
import { PERSON_NAME, PERSON_TAGLINE } from "../../config";
import { EDUCATION, RESUME_URL, RESUME_FILENAME } from "../../data/profile";
---

<section class="portfolio-hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Software engineering · Calgary, Canada</p>
    <h1 id="hero-title">{PERSON_NAME}<span class="hero-statement">{PERSON_TAGLINE}</span></h1>
    <p class="hero-intro">Data Engineer Intern at <strong>Royal Bank of Canada</strong> and Software Engineering student at the <strong>University of Calgary</strong>. From Snowflake data shares to full-stack applications, I care about the details that make a system dependable.</p>
    <div class="flex flex-wrap gap-3 mt-8">
      <a href="/experience#rbc" class="btn btn-gradient">Explore my experience <span aria-hidden="true">↗</span></a>
      <a href={RESUME_URL} download={RESUME_FILENAME} class="btn btn-outline border-base-content/25">Download resume <span aria-hidden="true">↓</span></a>
    </div>
    <div class="hero-meta"><span>B.Sc. Software Engineering</span><span>Expected {EDUCATION.graduation}</span><a href="/contact" class="text-primary hover:underline">Let’s connect ↗</a></div>
  </div>
  <aside class="snapshot-card" aria-label="Career at a glance">
    <div class="flex items-center justify-between"><span class="eyebrow mb-0">At a glance</span><span class="monogram" aria-hidden="true">EI<span>.</span></span></div>
    <div class="snapshot-role"><span class="text-sm text-base-content/70">Current internship</span><h2>Data Engineer Intern</h2><p>Royal Bank of Canada (RBC)</p><span class="text-sm text-base-content/70">May – December 2026 · Calgary, AB</span></div>
    <ul class="snapshot-list"><li><span>01</span> Snowflake & SQL validation</li><li><span>02</span> API quota automation</li><li><span>03</span> Secure access to enterprise data</li></ul>
    <a href="/resume" class="snapshot-link">View full resume <span aria-hidden="true">↗</span></a>
  </aside>
</section>
