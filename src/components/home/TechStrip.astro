---
import { SKILLS } from "../../data/profile";
---
<section class="section-block" aria-labelledby="skills-title">
  <div class="section-heading"><div><p class="eyebrow">Tools I work with</p><h2 id="skills-title">From data to delivery.</h2></div></div>
  <div class="space-y-6">{SKILLS.map(category => (
    <div class="skill-row"><h3>{category.label}</h3><ul class="flex flex-wrap gap-2">{category.items.map(skill => <li class="skill-chip">{skill}</li>)}</ul></div>
  ))}</div>
</section>
