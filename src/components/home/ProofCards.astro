---
const highlights = [
  { number: '01', title: 'Restore trust in data', detail: 'Resolved a Snowflake refresh issue that had left one data share stale for four months.', context: 'RBC · Data validation' },
  { number: '02', title: 'Automate the routine', detail: 'Built hourly API usage checks that increase quotas as usage approaches the limit.', context: 'RBC · Service reliability' },
  { number: '03', title: 'Keep access controlled', detail: 'Rotate service and application secrets and verify permissions for internal data shares.', context: 'RBC · Secure authentication' },
];
---
<section class="section-block" aria-labelledby="impact-title">
  <div class="section-heading"><div><p class="eyebrow">Experience in practice</p><h2 id="impact-title">Small details. Meaningful impact.</h2></div><a href="/experience#rbc" class="section-link">Inside my RBC role ↗</a></div>
  <div class="grid md:grid-cols-3 gap-4">{highlights.map(item => (
    <article class="impact-card"><span class="index-number" aria-hidden="true">{item.number}</span><h3>{item.title}</h3><p>{item.detail}</p><span class="impact-context">{item.context}</span></article>
  ))}</div>
</section>
