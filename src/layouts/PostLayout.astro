---
import { type BlogSchema } from "../content/config";
import type { MarkdownHeading } from "astro";
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";

export interface Props extends BlogSchema {
  headings?: MarkdownHeading[];
  readingMinutes?: number;
}

const { title, description, pubDate, updatedDate, heroImage, badge, tags = [], headings = [], readingMinutes } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat("en-CA", {
  month: "short", day: "numeric", year: "numeric", timeZone: "UTC",
});
const tableOfContents = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={title} description={description} image={heroImage} activeItemID="blog" ogType="article">
  <article class="mx-auto w-full max-w-[750px]">
    <a href="/blog" class="text-sm text-primary hover:underline mb-8 inline-flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      All articles
    </a>

    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold leading-tight tracking-tight">{title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-base-content/75">{description}</p>
      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-base-content/65">
        <span>By Emmanuel Idoro</span>
        <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
        {readingMinutes && <span>{readingMinutes} min read</span>}
      </div>
      {updatedDate && (
        <p class="mt-2 text-sm text-base-content/65">
          Updated <time datetime={updatedDate}>{dateFormatter.format(new Date(updatedDate))}</time>
        </p>
      )}
      <div class="mt-4 flex flex-wrap gap-2">
        {badge && <span class="badge badge-secondary">{badge}</span>}
        {tags.map((tag) => (
          <a href={`/blog/tag/${encodeURIComponent(tag)}`} class="badge badge-outline h-auto min-h-7 py-1 hover:bg-base-200">{tag}</a>
        ))}
      </div>
    </header>

    {heroImage && <Image width={750} height={422} format="webp" src={heroImage} alt="" class="w-full mb-8 rounded-2xl" />}

    {tableOfContents.length > 1 && (
      <details class="mb-8 rounded-2xl border border-base-300 bg-base-200/40 p-5">
        <summary class="cursor-pointer font-semibold">In this article</summary>
        <nav aria-label="Table of contents" class="mt-4">
          <ol class="list-decimal space-y-2 pl-5 text-sm">
            {tableOfContents.map((heading) => (
              <li><a href={`#${heading.slug}`} class="text-primary hover:underline">{heading.text}</a></li>
            ))}
          </ol>
        </nav>
      </details>
    )}

    <div class="prose prose-lg max-w-none prose-img:mx-auto prose-headings:scroll-mt-24">
      <slot />
    </div>
    <footer class="mt-12 border-t border-base-300 pt-6 text-sm">
      <a href="/blog" class="text-primary hover:underline">Explore more engineering notes →</a>
    </footer>
  </article>
</BaseLayout>
